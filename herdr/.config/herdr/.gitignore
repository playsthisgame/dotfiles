# herdr runtime artifacts (machine-local, not for syncing)
*.log
*.sock
session.json
.plugins.lock

# Plugin registry: herdr regenerates this per machine with absolute paths
# ($HOME differs between machines), so it can't be shared. Vendored plugin
# sources live in plugins/local/; register them on a new machine with
#   herdr plugin link ~/.config/herdr/plugins/local/<plugin>
plugins.json

# herdr's managed install dir for `herdr plugin install` — machine-local.
# Binds in config.toml reference these plugins by id, so a new machine needs:
#   herdr plugin install smarzban/herdr-file-viewer --yes
#   brew install glow git-delta bat        # optional renderers
# Skipping this does not error — `herdr config check` still reports "ok" and
# the plugin_action binds just silently do nothing.
plugins/github/
plugins/config/
